POSTGRES_DB=ngx_dash
POSTGRES_USER=replace-with-db-user
POSTGRES_PASSWORD=replace-with-db-password
DATABASE_URL=postgresql+psycopg://replace-with-db-user:replace-with-db-password@postgres:5432/ngx_dash
JWT_SECRET_KEY=replace-with-a-long-random-secret
# Required server-only secret: base64url-encoded 64 random bytes. See docs/personal_data_encryption.md.
PERSONAL_DATA_KEY=
CORS_ORIGINS=http://localhost:8080,http://localhost:3000
ADMIN_EMAILS=
STOCK_SYNC_INTERVAL_SECONDS=900
NGXPULSE_API_KEY=
FRONTEND_BASE_URL=http://localhost:8080
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
RESEND_API_KEY=
RESEND_FROM_EMAIL=
